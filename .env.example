# Groq LLM API Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Embedding Model Configuration
# Uses fastembed locally. Default is BAAI/bge-small-en-v1.5 (384-dimensional).
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Degraded mode fallback: Set to true ONLY in local dev/testing if fastembed model weights are offline.
# When false (default), missing embedding model safely returns unranked search results.
USE_HASH_EMBEDDING_FALLBACK=false

# CORS Configuration
# Origin allowed to make cross-origin API requests to FastAPI backend
FRONTEND_ORIGIN=http://localhost:3000

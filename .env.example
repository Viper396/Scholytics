# Python Version (Required on Render)
# Render defaults to Python 3.13 where FastEmbed wheels are unavailable.
# Set PYTHON_VERSION=3.11.10 in your Render environment variables.
PYTHON_VERSION=3.11.10

# Groq LLM API Configuration
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Embedding Model Configuration
# Uses fastembed locally. Default is BAAI/bge-small-en-v1.5 (384-dimensional).
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Degraded mode fallback: Set to true ONLY in local dev/testing if fastembed model weights are offline.
# When false (default), missing embedding model safely returns unranked search results.
USE_HASH_EMBEDDING_FALLBACK=false

# CORS Configuration
# Origin allowed to make cross-origin API requests to FastAPI backend
FRONTEND_ORIGIN=http://localhost:3000

# Vector Store Backend
# Supported values: "chroma" (default, in-process, no credentials needed)
#                   "pinecone" (production; requires PINECONE_API_KEY)
VECTOR_STORE_BACKEND=chroma

# Pinecone Configuration (required only when VECTOR_STORE_BACKEND=pinecone)
# Create a free serverless index at https://app.pinecone.io with:
#   dimension = 384, metric = cosine
# Then set:
PINECONE_API_KEY=
PINECONE_INDEX_NAME=scholytics-papers

# Cross-Encoder Reranking
# Disabled by default (recommended) to stay strictly within Render's 512MB RAM and free-tier CPU budget.
# Enable only in environments with >=1GB RAM and multi-core CPU.
ENABLE_RERANKER=false
RERANKER_MODEL_NAME=cross-encoder/ms-marco-TinyBERT-L-2-v2
